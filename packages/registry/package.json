{
  "name": "@agenteer/registry",
  "version": "1.0.0-rc.1",
  "description": "Agenteer registry: publish, install, search, and pin Agenteer-shaped node packages via npm.",
  "keywords": [
    "agenteer",
    "agent",
    "registry",
    "npm",
    "publish",
    "install",
    "ajv",
    "json-schema",
    "manifest"
  ],
  "author": "salehsquared (https://github.com/salehsquared)",
  "license": "MIT",
  "homepage": "https://github.com/salehsquared/agenteer#readme",
  "bugs": {
    "url": "https://github.com/salehsquared/agenteer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salehsquared/agenteer.git",
    "directory": "packages/registry"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agenteer/core": "1.0.0-rc.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^3.2.4"
  }
}
