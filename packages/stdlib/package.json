{
  "name": "@agenteer/stdlib",
  "version": "1.0.0-rc.1",
  "description": "Agenteer standard library — 18 hardened, publishable nodes (primitives, validators, meta, humans, planner, context).",
  "keywords": [
    "agenteer",
    "agent",
    "stdlib",
    "nodes",
    "primitives",
    "validators",
    "planner",
    "llm",
    "tools"
  ],
  "author": "salehsquared (https://github.com/salehsquared)",
  "license": "MIT",
  "homepage": "https://github.com/salehsquared/agenteer#readme",
  "bugs": {
    "url": "https://github.com/salehsquared/agenteer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salehsquared/agenteer.git",
    "directory": "packages/stdlib"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agenteer/core": "1.0.0-rc.1",
    "@agenteer/trust": "1.0.0-rc.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "vitest": "^3.2.4"
  }
}
