{
  "name": "@agenteer/cli",
  "version": "0.0.1",
  "description": "Agenteer CLI: run workflows, resume sessions, inspect context and traces.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agenteer": "./dist/bin/agenteer.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agenteer/core": "0.0.1",
    "@agenteer/stdlib": "0.0.1",
    "@agenteer/trust": "0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "vitest": "^3.2.4"
  }
}
