{
  "name": "agenteer-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Agenteer — debuggable context + hardened node library + dynamic composition",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
