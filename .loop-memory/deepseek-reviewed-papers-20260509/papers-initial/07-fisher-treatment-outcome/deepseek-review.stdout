            {
              "id": "F3",
              "severity": "major",
              "category": "method_choice",
              "title": "No confounding control in observational analysis",
              "evidenceRefs": [
                "manuscript.md",
                "stats-run.json"
              ],
              "whyItMatters": "Even strictly associative claims require consideration of confounding. Presenting a univariate odds ratio from a 2×2 table without any adjustment or matching can be misleading and does not support any meaningful inference.",
              "actionableFix": "Either restrict the report to purely descriptive statistics (without odds ratio) or conduct an adjusted analysis with prespecified covariates and state limitations regarding residual confounding.",
              "reentryPoint": "method_selection",
              "deterministicVerification": "The only test performed is Fisher's exact on two binary variables; no other covariates or adjustment methods are present in artifacts.",
              "confidence": 0.9
