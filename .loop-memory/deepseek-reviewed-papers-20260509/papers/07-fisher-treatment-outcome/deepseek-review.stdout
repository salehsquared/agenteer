              ],
              "whyItMatters": "Confidence intervals are essential for interpreting the precision of the effect estimate and are standard in reporting association measures.",
              "actionableFix": "Report the 95% confidence interval for the odds ratio from the Fisher exact test, or at minimum note why it is not available.",
              "reentryPoint": "execution",
              "deterministicVerification": "Check if the stats runner can produce CI from Fisher's exact test; if not, compute manually using the contingency table.",
              "confidence": 0.95
