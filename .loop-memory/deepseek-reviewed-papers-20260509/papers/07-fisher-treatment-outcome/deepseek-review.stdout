              ],
              "whyItMatters": "Without details on inclusion/exclusion criteria and missing data handling, the internal validity and generalizability of the finding cannot be assessed, and reproducibility is hindered.",
              "actionableFix": "Describe the data source, original sample size, criteria for case exclusion, and the pattern of missingness. Include a flowchart or table of missing data.",
              "reentryPoint": "manuscript",
              "deterministicVerification": "Check for any companion artifacts documenting cohort construction; if none, request addition.",
              "confidence": 0.9
