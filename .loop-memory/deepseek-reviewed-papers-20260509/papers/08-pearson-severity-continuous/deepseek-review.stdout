          "verdict": "block",
          "summary": "Essential Pearson correlation assumption checks (linearity, normality, outliers, homoscedasticity) are absent from the diagnostics artifact and not described. Without these, the reported correlation (r=0.658, p<0.001) is untrustworthy. The report also lacks a confidence interval, missingness analysis, and data plausibility review. The manuscript incorrectly claims QA issues were found when none are recorded. Analysis must be rerun with proper diagnostics and reporting before any claims.",
          "findings": [
            {
              "id": "missing-pearson-diagnostics",
              "severity": "blocker",
              "category": "model_diagnostics",
              "title": "No diagnostic checks for Pearson correlation assumptions",
              "evidenceRefs": [
                "stats-run/diagnostics.json"
              ],
              "whyItMatters": "Pearson requires linearity, bivariate normality, and homoscedasticity. Violations can invalidate the correlation coefficient and p-value.",
              "actionableFix": "Run and document diagnostic plots (residuals vs. fitted, Q-Q), normality tests (Shapiro-Wilk), and consider robust alternatives (e.g., Spearman) if violations are present.",
              "reentryPoint": "execution",
              "deterministicVerification": null,
              "confidence": 0.95
            },
            {
              "id": "empty-diagnostics-artifact",
              "severity": "major",
              "category": "reproducibility",
              "title": "Diagnostics artifact contains only test name and sample size",
              "evidenceRefs": [
                "stats-run/diagnostics.json"
              ],
              "whyItMatters": "No evidence that assumption checks were performed or inspected, making the analysis irreproducible and the result suspect.",
              "actionableFix": "Extend the diagnostics.json to include numeric and visual results for normality, linearity, and outlier detection.",
              "reentryPoint": "execution",
              "deterministicVerification": null,
              "confidence": 1
            },
            {
              "id": "missing-confidence-interval",
              "severity": "major",
              "category": "reporting",
              "title": "Confidence interval for correlation not reported",
              "evidenceRefs": [
                "stats-run/stats-run.json",
                "manuscript.md"
              ],
              "whyItMatters": "A point estimate (0.658) alone is insufficient; a 95% CI communicates the precision of the estimate and is essential for interpretation.",
              "actionableFix": "Compute and report a 95% confidence interval for the Pearson correlation coefficient.",
              "reentryPoint": "execution",
              "deterministicVerification": null,
              "confidence": 1
            },
            {
              "id": "missingness-not-documented",
              "severity": "major",
              "category": "missingness",
              "title": "No description of missing data handling or complete-case exclusions",
              "evidenceRefs": [
                "manuscript.md"
              ],
              "whyItMatters": "Complete-case analysis can introduce selection bias if missingness is related to exposure or outcome; readers cannot assess the impact without details.",
              "actionableFix": "Report number of records excluded, reasons, compare included/excluded groups on available variables, and discuss potential bias.",
              "reentryPoint": "dataset_feasibility",
              "deterministicVerification": null,
              "confidence": 0.9
            },
            {
