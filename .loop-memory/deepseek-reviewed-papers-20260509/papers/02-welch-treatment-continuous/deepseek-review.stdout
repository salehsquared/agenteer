          "verdict": "revise",
          "summary": "The analysis has critical reporting deficiencies: p-value incorrectly reported as 0.0000, lack of confidence interval for the mean difference, missing standard deviations, insufficient cohort description, and unreproducible without raw data. Additionally, the figure may be invalid due to extremely low non-blank ratio. These issues must be corrected before the manuscript is acceptable.",
          "findings": [
            {
              "id": "F1",
              "severity": "blocker",
              "category": "reporting",
              "title": "P-value reported as 0.0000 is inaccurate and misleading",
              "evidenceRefs": [
                "manuscript.md (Results: p=0.0000)",
                "stats-run.json (p_value: 3.8287252527457425e-10)"
              ],
              "whyItMatters": "Rounding a very small p-value to 0.0000 erases the actual strength of evidence and violates statistical reporting standards (e.g., ASA statement).",
              "actionableFix": "Report the exact p-value in scientific notation (e.g., p = 3.83e-10) or use p < 0.001 if a threshold reporting is preferred, and explain the choice.",
              "reentryPoint": "manuscript",
              "deterministicVerification": "p-value from stats-run is 3.8287252527457425e-10, not 0.",
              "confidence": 1
            },
            {
              "id": "F2",
              "severity": "major",
              "category": "reporting",
              "title": "No confidence interval for the mean difference",
              "evidenceRefs": [
                "manuscript.md (Results only reports mean difference and p)",
                "stats-run.json (no CI field in estimates)"
              ],
              "whyItMatters": "A point estimate without a confidence interval prevents assessment of precision and clinical/practical significance.",
              "actionableFix": "Compute and report the 95% confidence interval for the mean difference (e.g., from the t-distribution or by bootstrapping).",
              "reentryPoint": "execution",
              "deterministicVerification": null,
              "confidence": 0.95
            },
            {
              "id": "F3",
              "severity": "minor",
              "category": "reporting",
