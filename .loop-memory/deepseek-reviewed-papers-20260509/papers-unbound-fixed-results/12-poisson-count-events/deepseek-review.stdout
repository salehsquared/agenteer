          "verdict": "revise",
          "summary": "Major methodological issues including lack of overdispersion assessment, missing data handling, unbound analysis, and inappropriate diagnostics compromise interpretability. The analysis is exploratory and not ready for clinical inference.",
          "findings": [
            {
              "id": "F1",
              "severity": "blocker",
              "category": "model_diagnostics",
              "title": "Overdispersion not assessed for Poisson regression",
              "evidenceRefs": [
                "stats-run.json",
                "diagnostics.json"
              ],
              "whyItMatters": "Poisson regression assumes mean equals variance. Overdispersion inflates Type I error and biases standard errors, leading to spurious significance.",
              "actionableFix": "Conduct an overdispersion test (e.g., dispersion parameter from Pearson chi-square / df) and switch to negative binomial or quasi-Poisson if present.",
              "reentryPoint": "execution",
              "deterministicVerification": "Check if dispersion parameter >1.5 in model output.",
              "confidence": 0.95
            },
            {
              "id": "F2",
              "severity": "major",
              "category": "missingness",
              "title": "No reporting of missing data or cohort attrition",
              "evidenceRefs": [
                "manuscript.md"
              ],
              "whyItMatters": "Complete-case analysis can introduce selection bias if missingness is related to outcome or exposure. Without reporting initial sample size, exclusions, and missingness patterns, bias cannot be assessed.",
              "actionableFix": "Provide a flow chart from initial target population to final analytic sample, describing missing data mechanisms and considering sensitivity analyses or multiple imputation.",
              "reentryPoint": "dataset_feasibility",
              "deterministicVerification": null,
              "confidence": 0.9
            },
            {
              "id": "F3",
              "severity": "major",
              "category": "study_design",
              "title": "Analysis is unbound and not governed by a pre-specified plan",
              "evidenceRefs": [
                "stats-run.json",
                "manuscript.md"
              ],
              "whyItMatters": "Results are exploratory and do not support confirmatory claims. The manuscript’s cautious language partially acknowledges this, but the presentation of estimates and p-values without binding to an analysis spec risks misinterpretation.",
              "actionableFix": "Either bind the analysis to a prior protocol or analysis spec as specified in the result posture, or rename the entire manuscript as an exploratory report with explicit statement that no hypothesis testing is conducted.",
              "reentryPoint": "analysis_spec",
              "deterministicVerification": null,
              "confidence": 0.85
            },
            {
              "id": "F4",
              "severity": "major",
              "category": "model_diagnostics",
              "title": "Inappropriate use of Shapiro-Wilk test on Poisson residuals",
              "evidenceRefs": [
                "diagnostics.json"
              ],
              "whyItMatters": "Poisson residuals are not expected to be normally distributed; the Shapiro test is meaningless and may mislead reviewers. Proper diagnostics include deviance residual plots, Q-Q plots against theoretical quantiles, or standardized Pearson residuals.",
              "actionableFix": "Remove Shapiro test. Replace with visualization of deviance residuals versus fitted values, scale-location plots, and check for influential observations using Cook’s distance.",
              "reentryPoint": "execution",
              "deterministicVerification": null,
              "confidence": 0.95
            },
            {
              "id": "F5",
              "severity": "major",
              "category": "method_choice",
              "title": "Zero-inflation not examined for count outcome",
              "evidenceRefs": [
                "manuscript.md"
              ],
              "whyItMatters": "Count outcomes often exhibit excess zeros (e.g., patients with no events), which violates Poisson distributional assumptions. Ignoring zero-inflation biases parameter estimates and inflates model fit.",
              "actionableFix": "Test for zero-inflation (e.g., Vuong test, likelihood ratio test for zero-inflated vs. Poisson) and consider zero-inflated Poisson (ZIP) or hurdle models if present.",
              "reentryPoint": "method_selection",
              "deterministicVerification": null,
              "confidence": 0.9
            },
            {
              "id": "F6",
              "severity": "major",
              "category": "causal_claims",
              "title": "Potential omitted confounders and no causal justification",
              "evidenceRefs": [
                "manuscript.md"
              ],
              "whyItMatters": "Only age and severity were adjusted for; the study is observational and lacks a causal identification strategy (e.g., DAG, propensity scores, instrumental variable). Residual confounding is likely.",
              "actionableFix": "Either develop a causal diagram to justify included covariates, or perform a sensitivity analysis (e.g., E-value) to quantify potential unmeasured confounding. Alternatively, reframe the analysis purely as a prediction model without causal language.",
              "reentryPoint": "protocol",
              "deterministicVerification": null,
              "confidence": 0.85
            },
            {
              "id": "F7",
              "severity": "minor",
              "category": "reporting",
              "title": "Variable definitions, coding, and measurement missing from manuscript",
              "evidenceRefs": [
                "manuscript.md"
              ],
              "whyItMatters": "Reproducibility and clinical interpretability require explicit operational definitions for treatment, severity, age (continuous? cut-offs?), and how count events were ascertained.",
              "actionableFix": "Add a variables table with definitions, type, range, and source. Include whether ‘treatment’ is a binary indicator and how severity was scored.",
              "reentryPoint": "manuscript",
              "deterministicVerification": null,
              "confidence": 0.8
            },
            {
