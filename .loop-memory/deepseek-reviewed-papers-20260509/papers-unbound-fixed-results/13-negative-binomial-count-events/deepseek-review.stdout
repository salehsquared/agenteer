              "evidenceRefs": [
                "stats-run/stats-run.json warnings"
              ],
              "whyItMatters": "A negative binomial model with alpha=1.0 is effectively a Poisson model and does not account for overdispersion. The entire model family justification (count with overdispersion) is undermined, and standard errors and p-values may be incorrect.",
              "actionableFix": "Re-fit the model with alpha estimated by maximum likelihood (default in statsmodels if not fixed) or use a dispersion-aware method. Compare with Poisson and quasi-Poisson. Report the estimated alpha and its confidence interval.",
              "reentryPoint": "execution",
              "deterministicVerification": "Check statsmodels documentation: NegativeBinomial defaults to alpha=1 if not specified, leading to Poisson-like behavior.",
